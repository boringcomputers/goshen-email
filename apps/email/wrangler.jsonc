{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bezalel-email-standalone",
  "account_id": "c340deebb91d89c14d17239b7658dc81",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // PlanetScale bezalel-email/main in Northern Virginia. Keep query caching disabled.
      "id": "d74b7d9147a348ae985ac889fb36232b",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5434/bezalel_email_dev"
    }
  ],
  "vars": {
    "WORKER_NAME": "bezalel-email-standalone",
    "CLOUDFLARE_ACCOUNT_ID": "c340deebb91d89c14d17239b7658dc81",
    "EMAIL_DOMAINS": "{}",
    "PUBLIC_EMAIL_URL": "https://bezalel-email-standalone.michaelwasihun96.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "MAIL_OBJECTS",
      "bucket_name": "bezalel-email-standalone"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "bezalel-email-standalone-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "dead_letter_queue": "bezalel-email-standalone-delivery-dead"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
