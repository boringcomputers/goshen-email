{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bezalel-email-standalone",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "WORKER_NAME": "bezalel-email-standalone",
    "DEFAULT_EMAIL_DOMAIN": "example.com",
    "EMAIL_DOMAINS": "{\"example.com\": \"00000000000000000000000000000000\"}",
    "PUBLIC_EMAIL_URL": "https://mail.example.com"
  },
  "r2_buckets": [
    {
      "binding": "MAIL_OBJECTS",
      "bucket_name": "bezalel-email-standalone"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "bezalel-email-standalone-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "dead_letter_queue": "bezalel-email-standalone-delivery-dead"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
