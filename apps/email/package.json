    "@types/html-to-text": "9.0.4",
    "@types/node": "^24.10.9",
    "@types/pg": "8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "4.129.0"
