{
  "name": "@bezalel/email",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "deploy": "wrangler deploy",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "api:generate": "tsx scripts/generate-api.ts",
    "api:check": "tsx scripts/generate-api.ts --check"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "html-to-text": "10.0.1",
    "jose": "6.1.3",
    "kysely": "0.28.17",
    "pg": "8.23.0",
    "postal-mime": "3.0.0",
    "zod": "4.4.3",
    "goshenemail-mcp": "workspace:*",
    "@goshenemail/client": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260906.1",
    "@electric-sql/pglite": "^0.4.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "^24.10.9",
    "@types/pg": "8.23.1",
    "kysely-pglite": "0.6.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.129.0",
    "openapi-typescript": "7.13.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "goshenemail-cli": "workspace:*"
  }
}
