{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bezalel-email-dashboard",
  "account_id": "c340deebb91d89c14d17239b7658dc81",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "goshenemail.com", "custom_domain": true },
    { "pattern": "www.goshenemail.com", "custom_domain": true }
  ],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "DASHBOARD", "class_name": "Dashboard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Dashboard"] }],
  "services": [
    { "binding": "MAIL_API", "service": "bezalel-email-standalone" },
    { "binding": "NATIVE_MAIL_API", "service": "bezalel-email" }
  ],
  // NATIVE_MAIL_ADMIN_EMAILS (the read-only Bezalel inboxes allowlist) and NATIVE_MAIL_API_TOKEN
  // are Worker secrets: `wrangler secret put <NAME>`. Wrangler keeps secrets across deploys.
  "vars": {
    "DASHBOARD_AUTH_MODE": "account",
    "DASHBOARD_PUBLIC_URL": "https://goshenemail.com",
    "MAIL_WORKER_URL": "https://bezalel-email-standalone.michaelwasihun96.workers.dev",
    "NATIVE_MAIL_WORKER_URL": "https://bezalel-email.michaelwasihun96.workers.dev"
  },
  "observability": { "enabled": false }
}
