{
  "name": "bezalel-email",
  "private": true,
  "description": "Email inboxes for AI agents: API, dashboard, and SMTP gateway",
  "license": "AGPL-3.0-only",
  "homepage": "https://goshenemail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boringcomputers/goshen-email.git"
  },
  "bugs": "https://github.com/boringcomputers/goshen-email/issues",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @bezalel/email-dashboard dev",
    "start": "pnpm --filter @bezalel/email-dashboard start",
    "build": "pnpm -r build",
    "check": "pnpm -r check && pnpm api:check",
    "test": "pnpm -r test",
    "test:postgres": "pnpm --filter @bezalel/email test:postgres",
    "dev:worker": "pnpm --filter @bezalel/email dev",
    "deploy:worker": "pnpm --filter @bezalel/email run deploy",
    "migrate": "pnpm --filter @bezalel/email migrate",
    "source:check": "node scripts/verify-source.mjs",
    "deploy:dashboard": "pnpm --filter @bezalel/email-dashboard run deploy",
    "api:generate": "pnpm --filter @bezalel/email api:generate",
    "api:check": "pnpm --filter @bezalel/email api:check",
    "docs:generate": "pnpm --filter @bezalel/email-dashboard docs:generate",
    "docs:check": "pnpm --filter @bezalel/email-dashboard docs:check"
  }
}
