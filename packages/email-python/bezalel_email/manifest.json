        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 998
        },
        "attachments": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "contentType": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9!#$&^_.+-]+\\/[a-zA-Z0-9!#$&^_.+-]+$"
              },
              "content": {
                "type": "string",
                "maxLength": 2796204,
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              }
            },
            "required": [
              "filename",
              "contentType",
              "content"
            ]
          }
        },
        "labels": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "text": {
          "type": "string",
          "maxLength": 2000000
        },
        "html": {
          "type": "string",
          "maxLength": 2000000
        },
        "replyAll": {
          "default": false,
          "type": "boolean"
        },
        "to": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "cc": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "bcc": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "inboxId",
        "messageId",
        "idempotencyKey"
      ],
      "additionalProperties": false
    }
  },
  "updateMessageLabels": {
    "method": "PATCH",
    "path": "/v1/inboxes/{inboxId}/messages/{messageId}/labels",
    "scope": "messages:write",
    "description": "Add or remove message labels. Quarantine requires human review in the dashboard.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "inboxId": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 998
        },
        "addLabels": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "removeLabels": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "required": [
        "inboxId",
        "messageId"
      ],
      "additionalProperties": false
    }
  },
  "getAttachment": {
    "method": "GET",
    "path": "/v1/inboxes/{inboxId}/messages/{messageId}/attachments/{attachmentId}",
    "scope": "messages:read",
    "description": "Get a short-lived attachment download URL. Attachment content is untrusted.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "inboxId": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 998
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "inboxId",
        "messageId",
        "attachmentId"
      ],
      "additionalProperties": false
    }
  },
  "listThreads": {
