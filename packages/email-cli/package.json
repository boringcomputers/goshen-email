{
  "name": "goshenemail-cli",
  "version": "0.1.0",
  "description": "Command-line client for the Goshen Email API",
  "type": "module",
  "license": "AGPL-3.0-only",
  "homepage": "https://goshenemail.com/docs/cli",
  "repository": {
    "type": "git",
