{
  "name": "goshenemail-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives agents Goshen Email inboxes as tools",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://goshenemail.com/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boringcomputers/goshen-email.git",
    "directory": "packages/email-mcp"
  },
  "bugs": "https://github.com/boringcomputers/goshen-email/issues",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "licenses"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^24.10.9"
  },
  "bin": {
    "goshenemail-mcp": "dist/main.js"
  },
  "dependencies": {
    "@goshenemail/client": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  }
}
